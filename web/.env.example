# Sextant Web Workbench
# Only the LLM/provider boundary may use deterministic local output.
# All non-LLM production behavior must use real API, persistence, and worker contracts.

VITE_SEXTANT_LLM_PROVIDER=deterministic
VITE_SEXTANT_ENABLE_DEMO=false
VITE_SEXTANT_API_BASE_URL=http://localhost:8000
VITE_SEXTANT_PROJECT_ID=
VITE_SEXTANT_ACTOR_ID=
# Local/manual only. Do not set this in hosted static frontend deployments.
VITE_SEXTANT_BEARER_TOKEN=
# Hosted production runtime auth. These are public Supabase Auth client values,
# not service-role secrets; the author signs in at runtime to obtain a JWT.
VITE_SEXTANT_SUPABASE_URL=
VITE_SEXTANT_SUPABASE_PUBLISHABLE_KEY=
VITE_SEXTANT_SOURCE_ID=
VITE_SEXTANT_SOURCE_VERSION_ID=
VITE_SEXTANT_SCENE_ID=
VITE_SEXTANT_POV_CHARACTER_ID=
