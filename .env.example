# Sextant local provider configuration template.
# Copy to .env and fill SEXTANT_OPENAI_API_KEY with your Bailian/DashScope API key.
# Do not commit real secrets.

# Local runtime defaults. These keep persistence/API/worker real while using
# local files for development state.
SEXTANT_RELEASE_ENVIRONMENT=development
SEXTANT_DATABASE_URL=sqlite+pysqlite:///./.sextant/local.db
SEXTANT_OBJECT_STORE_ROOT=./.sextant/objects
SEXTANT_CORS_ORIGINS=http://127.0.0.1:5800
SEXTANT_AUTH_MODE=header-dev
SEXTANT_OBSERVABILITY_EXPORTER=none

# S3-compatible object-store safety bounds. Production R2/S3 reads must fail
# with a bounded timeout instead of hanging worker or maintenance processes.
SEXTANT_S3_CONNECT_TIMEOUT_SECONDS=10
SEXTANT_S3_READ_TIMEOUT_SECONDS=30
SEXTANT_S3_MAX_ATTEMPTS=3

# Bailian OpenAI-compatible endpoint.
# The variable name remains SEXTANT_OPENAI_* because the runtime uses the
# OpenAI-compatible SDK surface. Put the Bailian API key here.
SEXTANT_OPENAI_API_KEY=
# Production deployments may leave SEXTANT_OPENAI_API_KEY empty and use a
# supported secret-manager ref instead. Existing-stack Supabase Vault refs are
# shaped as supabase-vault://<project-ref>/<secret-name> and are read through
# SEXTANT_SUPABASE_VAULT_DATABASE_URL or SEXTANT_DATABASE_URL.
SEXTANT_LLM_API_KEY_SECRET_REF=
SEXTANT_SUPABASE_VAULT_DATABASE_URL=
SEXTANT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEXTANT_OPENAI_API_STYLE=chat

# Story drafting / candidate generation. Use the stronger model here because
# it directly affects author-facing prose quality and contract-following.
SEXTANT_LLM_PROVIDER=openai
SEXTANT_LLM_MODEL=deepseek-v4-pro
SEXTANT_LLM_REASONING_EFFORT=high

# Memory extraction. Flash is cheaper and fast; output is still validated before
# any memory/canon side effect.
SEXTANT_MEMORY_LLM_PROVIDER=openai
SEXTANT_MEMORY_LLM_MODEL=deepseek-v4-flash
SEXTANT_MEMORY_LLM_REASONING_EFFORT=high

# POV detection. This is bounded classification with evidence refs, so the
# economical model is the default.
SEXTANT_POV_LLM_PROVIDER=openai
SEXTANT_POV_LLM_MODEL=deepseek-v4-flash
SEXTANT_POV_LLM_REASONING_EFFORT=high

# Event aggregation. Conservative validation happens after provider output.
SEXTANT_EVENT_AGGREGATION_LLM_PROVIDER=openai
SEXTANT_EVENT_AGGREGATION_LLM_MODEL=deepseek-v4-flash
SEXTANT_EVENT_AGGREGATION_LLM_REASONING_EFFORT=high

# Cloud embedding through Bailian. The current default without these variables
# is local deterministic embeddings; this switches semantic recall to Bailian.
SEXTANT_EMBEDDING_PROVIDER=openai
SEXTANT_EMBEDDING_MODEL=text-embedding-v4
SEXTANT_EMBEDDING_DIMENSIONS=1024
SEXTANT_VECTOR_INDEX_PROVIDER=json

# Optional alternatives researched from Bailian docs:
# - deepseek-v4-pro: stronger general/coding/math model; supports reasoning_effort high|max.
# - deepseek-v4-flash: faster, cheaper model; supports reasoning_effort high|max.
# - kimi/kimi-k2.7-code-highspeed or kimi/kimi-k2.7-code: latest Kimi code line.
#   For Kimi/GLM thinking controls, prefer SEXTANT_*_ENABLE_THINKING=true|false.
# - glm-5.1: latest GLM line on Bailian-compatible chat.
#
# Example Kimi/GLM switches:
# SEXTANT_LLM_MODEL=kimi/kimi-k2.7-code-highspeed
# SEXTANT_LLM_ENABLE_THINKING=true
# SEXTANT_LLM_MODEL=glm-5.1
# SEXTANT_LLM_ENABLE_THINKING=true
